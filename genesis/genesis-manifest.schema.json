{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/achirothmane/easl/genesis/genesis-manifest.schema.json",
  "title": "EASL Genesis Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifest_version",
    "genesis_epoch",
    "sequence",
    "architecture_version",
    "specification",
    "verification",
    "threat_model",
    "trust",
    "enforcement",
    "implementation",
    "supply_chain",
    "validity",
    "approval",
    "authenticity"
  ],
  "properties": {
    "manifest_version": { "type": "string", "minLength": 1 },
    "genesis_epoch": { "type": "integer", "minimum": 0 },
    "sequence": { "type": "integer", "minimum": 0 },
    "previous_manifest_hash": { "$ref": "#/$defs/sha256" },
    "architecture_version": { "type": "string", "minLength": 1 },
    "specification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["spec_hash", "invariant_set_hash", "assumption_set_hash", "forbidden_state_set_hash", "tau_bounds_hash"],
      "properties": {
        "spec_hash": { "$ref": "#/$defs/sha256" },
        "invariant_set_hash": { "$ref": "#/$defs/sha256" },
        "assumption_set_hash": { "$ref": "#/$defs/sha256" },
        "forbidden_state_set_hash": { "$ref": "#/$defs/sha256" },
        "tau_bounds_hash": { "$ref": "#/$defs/sha256" }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["verification_mode", "proof_status", "proof_artifacts", "toolchain", "model_bounds", "proof_scope_hash"],
      "properties": {
        "verification_mode": { "enum": ["model_checked", "theorem_proved", "mixed"] },
        "proof_status": { "enum": ["PASS", "FAIL", "INCOMPLETE"] },
        "proof_artifacts": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "toolchain": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "model_bounds": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "proof_scope_hash": { "$ref": "#/$defs/sha256" }
      }
    },
    "threat_model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["threat_model_hash", "capability_envelope_hash"],
      "properties": {
        "threat_model_hash": { "$ref": "#/$defs/sha256" },
        "capability_envelope_hash": { "$ref": "#/$defs/sha256" }
      }
    },
    "trust": {
      "type": "object",
      "additionalProperties": false,
      "required": ["trust_root_ref", "trust_root_epoch", "attestation_policy_hash", "nonce_policy_hash", "revocation_ref"],
      "properties": {
        "trust_root_ref": { "type": "string", "minLength": 1 },
        "trust_root_epoch": { "type": "integer", "minimum": 0 },
        "attestation_policy_hash": { "$ref": "#/$defs/sha256" },
        "nonce_policy_hash": { "$ref": "#/$defs/sha256" },
        "revocation_ref": { "type": "string", "minLength": 1 }
      }
    },
    "enforcement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enforcement_policy_hash", "default_deny_required"],
      "properties": {
        "enforcement_policy_hash": { "$ref": "#/$defs/sha256" },
        "default_deny_required": { "const": true }
      }
    },
    "implementation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["implementation_digest", "refinement_mapping_hash", "conformance_level", "executable_contract_hash"],
      "properties": {
        "implementation_digest": { "$ref": "#/$defs/sha256" },
        "refinement_mapping_hash": { "$ref": "#/$defs/sha256" },
        "conformance_level": { "enum": ["C0", "C1", "C2", "C3", "C4"] },
        "executable_contract_hash": { "$ref": "#/$defs/sha256" }
      }
    },
    "supply_chain": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_revision", "builder_identity", "build_provenance_ref", "materials_hash", "sbom_hash"],
      "properties": {
        "source_revision": { "type": "string", "minLength": 1 },
        "builder_identity": { "type": "string", "minLength": 1 },
        "build_provenance_ref": { "type": "string", "minLength": 1 },
        "materials_hash": { "$ref": "#/$defs/sha256" },
        "sbom_hash": { "$ref": "#/$defs/sha256" }
      }
    },
    "validity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["built_at", "valid_from", "valid_until", "minimum_accepted_epoch"],
      "properties": {
        "built_at": { "type": "string", "format": "date-time" },
        "valid_from": { "type": "string", "format": "date-time" },
        "valid_until": { "type": "string", "format": "date-time" },
        "minimum_accepted_epoch": { "type": "integer", "minimum": 0 }
      }
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["approved_by", "approval_policy_hash"],
      "properties": {
        "approved_by": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "approval_policy_hash": { "$ref": "#/$defs/sha256" }
      }
    },
    "authenticity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["canonicalization", "signature_scope", "signed_payload_hash", "signature_algorithm", "signer_key_id", "signature"],
      "properties": {
        "canonicalization": { "const": "RFC8785" },
        "signature_scope": { "const": "MANIFEST_EXCLUDING_AUTHENTICITY" },
        "signed_payload_hash": { "$ref": "#/$defs/sha256" },
        "signature_algorithm": { "type": "string", "minLength": 1 },
        "signer_key_id": { "type": "string", "minLength": 1 },
        "signature": { "type": "string", "minLength": 1 }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "sequence": { "minimum": 1 } },
        "required": ["sequence"]
      },
      "then": { "required": ["previous_manifest_hash"] }
    }
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    }
  }
}
